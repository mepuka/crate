    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@effect/cli": "^0.72.1",
    "@effect/cluster": "^0.52.8",
    "@effect/platform": "^0.93.0",
    "@effect/platform-bun": "^0.83.0",
    "@effect/platform-node": "^0.100.0",
    "@effect/rpc": "^0.72.1",
    "@effect/sql": "^0.48.0",
    "@effect/sql-sqlite-bun": "^0.49.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
