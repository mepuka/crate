{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "prepare": "effect-language-service patch",
    "clean": "bun run scripts/clean.mjs",
    "build": "bun run build-esm",
    "build-esm": "tsc -b tsconfig.build.json",
    "check": "tsc -b tsconfig.json",
    "test": "bun test",
    "dev:server": "bun --watch packages/server/src/server.ts",
    "migrate": "bun run packages/server/src/migrate.ts",
    "update:plays": "bun run packages/server/src/scripts/update_plays.ts",
    "backfill:plays": "bun run packages/server/src/scripts/backfill_plays.ts",
    "resolve:artists": "bun run packages/server/src/knowledge_base/test_scripts/test_fetch_unresolved.ts",
    "test:plays": "bun run packages/server/src/knowledge_base/test_scripts/test_fact_plays.ts",
    "tunnel:datasette": "echo 'Opening tunnel to Datasette at http://localhost:8001' && ssh -N -L 8001:127.0.0.1:8001 root@cratemusic.duckdns.org"
  },
  "devDependencies": {
    "@effect/build-utils": "^0.8.9",
    "@effect/experimental": "^0.58.0",
    "@effect/language-service": "^0.64.1",
    "@effect/vitest": "^0.27.0",
    "@types/node": "^24.1.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@effect/cli": "^0.73.0",
    "@effect/cluster": "^0.56.0",
    "@effect/platform": "^0.94.0",
    "@effect/platform-bun": "^0.87.0",
    "@effect/platform-node": "^0.104.0",
    "@effect/rpc": "^0.73.0",
    "@effect/sql": "^0.49.0",
    "@effect/sql-sqlite-bun": "^0.50.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "effect": "^3.19.13"
  },
  "resolutions": {
    "@effect/experimental": "^0.57.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@effect/ai@0.33.2": "patches/@effect__ai@0.33.2.patch"
    }
  }
