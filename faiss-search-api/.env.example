# Data paths (override if needed)
DATABASE_PATH=data/music_kb.sqlite
EMBEDDINGS_PATH=data/embeddings_384d.npy
PLAY_IDS_PATH=data/play_ids.npy
PCA_PATH=data/pca_transformer_256d.joblib
INDEX_PATH=data/embeddings_384d.index
METADATA_PATH=data/metadata.json

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
REQUIRE_API_KEY=true
DATA_HEALTH_CACHE_SECONDS=60

# API authentication for mutating endpoints
# Set a strong random value in production
FAISS_API_KEY=change-me

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# FAISS settings
FAISS_NLIST=1024
FAISS_NPROBE=10

# Pub/Sub for enrichment triggers (optional - disabled by default)
# Set PUBSUB_ENABLED=true to enable publishing to Cloud Pub/Sub
PUBSUB_ENABLED=false
# GCP_PROJECT_ID is REQUIRED when PUBSUB_ENABLED=true
# Uncomment and set to your project ID:
# GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC=new-plays
PUBSUB_TIMEOUT_SECONDS=30

# GCP credentials (for Pub/Sub publishing from non-GCP environments)
# On GCP (Cloud Run, Compute Engine, etc.), use default credentials instead
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
