{
  "name": "@crate/server",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "The server for Crate",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkessy/crate",
    "directory": "packages/server"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "bun run ./dist/server.js",
    "http:server": "bun run ./dist/http/server.js",
    "http:dev": "bun --watch ./src/http/server.ts",
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "clean": "rm -rf dist build .tsbuildinfo"
  },
  "dependencies": {
    "@crate/domain": "workspace:^",
    "@effect/experimental": "^0.58.0",
    "@effect/platform": "^0.94.0",
    "@effect/platform-node": "^0.104.0",
    "@effect/sql": "^0.49.0",
    "@effect/sql-sqlite-bun": "^0.50.0",
    "effect": "^3.19.13"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
