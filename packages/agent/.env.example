# =============================================================================
# Crate Agent Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# -----------------------------------------------------------------------------
# AI Services
# -----------------------------------------------------------------------------

# Anthropic Claude API (required for insight generation)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI / Gemini API (required for visual asset generation)
GOOGLE_AI_API_KEY=AIza...

# AI Model Selection (optional, defaults shown)
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# FAISS Search API
# -----------------------------------------------------------------------------

# URL to the FAISS search API (required)
FAISS_API_URL=https://cratemusic.duckdns.org

# API key for FAISS (optional, use 'placeholder' if not required)
FAISS_API_KEY=placeholder

# -----------------------------------------------------------------------------
# Pub/Sub Configuration (Cloud Run only)
# -----------------------------------------------------------------------------

# Expected service account email for Pub/Sub push verification (optional)
# Set to null/empty to disable app-level verification (rely on Cloud Run IAM)
# PUBSUB_INVOKER_EMAIL=scheduler-invoker@gen-lang-client-0874846742.iam.gserviceaccount.com

# -----------------------------------------------------------------------------
# MusicBrainz (optional, for metadata enrichment)
# -----------------------------------------------------------------------------

# User agent for MusicBrainz API (recommended format: AppName/Version contact@email)
# MUSICBRAINZ_USER_AGENT=Crate/1.0 (contact@example.com)

# -----------------------------------------------------------------------------
# Jina AI (optional, for content summarization)
# -----------------------------------------------------------------------------

# JINA_API_KEY=jina_...

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

# Enable debug logging
# DEBUG=1

# Log level (DEBUG, INFO, WARN, ERROR)
# LOG_LEVEL=INFO
