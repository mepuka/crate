{
  "name": "@crate/agent",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "AI Agent for interacting with FAISS search API",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkessy/crate",
    "directory": "packages/agent"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check": "tsc -b tsconfig.json",
    "dev": "bun --watch src/examples/basic.ts",
    "smoke:graph": "bun --env-file=.env src/scripts/smoke-test-graph.ts",
    "smoke:music-graph": "bun --env-file=.env src/scripts/smoke-test-music-graph.ts",
    "enrich": "bun --env-file=.env src/examples/run-enrichment.ts",
    "enrich:debug": "DEBUG=1 bun --env-file=.env src/examples/run-enrichment.ts",
    "verify:cloud": "bun --env-file=.env src/scripts/verify-cloud.ts",
    "test:cloud": "vitest run test/cloud-verification.test.ts"
  },
  "dependencies": {
    "@crate/api": "workspace:^",
    "@crate/domain": "workspace:^",
    "@effect/ai": "^0.33.0",
    "@effect/ai-anthropic": "^0.23.0",
    "@effect/ai-google": "^0.12.0",
    "@effect/ai-openai": "^0.37.0",
    "@effect/platform": "^0.94.0",
    "@effect/platform-node": "^0.104.0",
    "effect": "^3.19.13"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
