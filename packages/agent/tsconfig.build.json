{
  "extends": "./tsconfig.src.json",
  "include": ["src/**/*", "assets/**/*.json"],
  "exclude": ["src/mcp"],
  "compilerOptions": {
    "types": ["node"],
    "tsBuildInfoFile": ".tsbuildinfo/build.tsbuildinfo",
    "outDir": "build/esm",
    "declarationDir": "build/dts",
    "noEmit": false,
    "stripInternal": true
  }
}
