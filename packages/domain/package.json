{
  "name": "@crate/domain",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "The domain for Crate",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkessy/crate",
    "directory": "packages/domain"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./csv/*": {
      "import": "./dist/csv/*.js",
      "types": "./dist/csv/*.d.ts"
    },
    "./events/*": {
      "import": "./dist/events/*.js",
      "types": "./dist/events/*.d.ts"
    },
    "./faiss/*": {
      "import": "./dist/faiss/*.js",
      "types": "./dist/faiss/*.d.ts"
    },
    "./graph/*": {
      "import": "./dist/graph/*.js",
      "types": "./dist/graph/*.d.ts"
    },
    "./links/*": {
      "import": "./dist/links/*.js",
      "types": "./dist/links/*.d.ts"
    },
    "./kexp/*": {
      "import": "./dist/kexp/*.js",
      "types": "./dist/kexp/*.d.ts"
    },
    "./nlp/*": {
      "import": "./dist/nlp/*.js",
      "types": "./dist/nlp/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check": "tsc -b tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest --coverage",
    "clean": "rm -rf dist build .tsbuildinfo"
  },
  "dependencies": {
    "@effect/platform": "^0.93.0",
    "effect": "^3.19.3",
    "fast-csv": "^5.0.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
