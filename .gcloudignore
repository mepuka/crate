# =============================================================================
# .gcloudignore - Optimized for agent deployment
# Only include: packages/agent, packages/domain, root config files
# =============================================================================

# Exclude ALL large directories
/data/
/analysis/
/faiss-search-api/
/docs/
/.git/
/.worktrees/
/.claude/
/.beads/
/scratchpad/
/scripts/
/patches/

# Exclude node_modules everywhere (installed fresh in Docker)
node_modules/
**/node_modules/

# Exclude build artifacts (built fresh in Docker)
**/dist/
**/build/
**/.tsbuildinfo/

# Exclude all packages EXCEPT agent and domain
packages/web/
packages/api/
packages/server/
packages/shared/
packages/claude_effect_docs/

# Exclude test files and dev artifacts
**/*.test.ts
**/*.spec.ts
**/__tests__/
**/coverage/

# Exclude logs, temp, and env files
*.log
.DS_Store
.env
.env.*
!.env.example
